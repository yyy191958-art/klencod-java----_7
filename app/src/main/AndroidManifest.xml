<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تشكيلة رحومي"
            android:textColor="#00FF66"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etTeamName"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="اسم الفريق..."
                android:text="تشكيلة رحومي"
                android:textColor="#F3F7FA"
                android:textColorHint="#8FA1B3"
                android:background="#16202C"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/spPlayerCount"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="#16202C"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSavePng"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="حفظ صورة PNG"
                android:textColor="#06110A"
                android:textStyle="bold"
                android:backgroundTint="#00FF66" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="إعادة ضبط"
                android:textColor="#F3F7FA"
                android:backgroundTint="#16202C" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pitchContainer"
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:layout_marginBottom="14dp"
            android:background="#114B26" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قائمة اللاعبين والأرقام والصور (اضغط على الصورة لاختيارها من الجهاز)"
            android:textColor="#F3F7FA"
            android:text
